# cp env.sh.example env.sh, fill it in, then: source env.sh
# env.sh is gitignored.

# Needed to label a pasted SKILL.md, and by tools/build_embeddings.py.
# Browsing and the graphs work without it.
export OPENROUTER_API_KEY=""

# Sign-in. Without these the site runs fine and simply reports sign-in as unavailable,
# which also means saving a skill is unavailable — a saved skill needs an owner.
export SF_SECRET_KEY=""            # any long random string; signs the session cookie
export SF_GOOGLE_CLIENT_ID=""      # console.cloud.google.com → OAuth client (Web application)
export SF_GITHUB_CLIENT_ID=""      # github.com/settings/developers → New OAuth App
export SF_GITHUB_CLIENT_SECRET=""

# Where accounts live. Defaults to data/user.db.
# export SF_DB="$PWD/data/user.db"
